    "what is your name",
    "i am a student",
    "i am happy",
    "thank you",
    "where are you going",
    "i want water",
    "good morning",
    "goodbye"
]

for sentence in test_sentences:

    translation = translate_sentence(sentence)

    print(
        f"\nEnglish : {sentence}"
    )

    print(
        f"Hindi   : {translation}"
    )

# 18. INTERACTIVE TRANSLATOR

print("\n")
